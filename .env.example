# MySQL. En Railway: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:password@host:3306/railway

# Firma de la sesion del admin. Cadena larga y aleatoria.
JWT_SECRET=

# Secreto para crear el PRIMER admin. Borrar de Railway despues de crearlo.
ADMIN_SETUP_TOKEN=

# true = carga las 18 cepas al arrancar. Borrar de Railway despues del primer deploy.
SEED_CATALOG=

# Cloudflare R2 (PDF de laboratorio, fotos de producto y videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Opcional: aviso por email de cada mensaje de Contact Us (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: por defecto los avisos van al email de Contact details del panel.
CONTACT_TO_EMAIL=
